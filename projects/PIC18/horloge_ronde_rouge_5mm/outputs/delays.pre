# 36 "D:\Electronique\MCU\Libraries\delays.h"
void delay_us (u16 loop);

void delay_ms (u16 loop);

# 19 "D:\Electronique\MCU\Libraries\delays.c"
void delay_us (u16 loop)
{
u16 i, k;
for (i=loop; i!=0; i--)
for (k=(10000000ul)/200000000ul; k!=0; k--);
}

# 31
void delay_ms (u16 loop)
{

# 39
u16 i, k;
for (i=loop; i!=0; i--)
for (k=(10000000ul)/60200; k!=0; k--);

}

