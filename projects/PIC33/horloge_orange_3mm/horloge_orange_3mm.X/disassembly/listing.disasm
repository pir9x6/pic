00193C  FB8489     ZE W9, W9
00193E  448089     ADD W9, W9, W1
001940  780008     MOV W8, W0
001942  07FDA9     RCALL i2c_write
25:                    i2c_write(i2c_bus_id, data);
001944  78408A     MOV.B W10, W1
001946  780008     MOV W8, W0
001948  07FDA6     RCALL i2c_write
26:                    i2c_stop(i2c_bus_id);
00194A  780008     MOV W8, W0
00194C  07FD88     RCALL i2c_stop
27:                }
00194E  78054F     MOV [--W15], W10
001950  BE044F     MOV.D [--W15], W8
001952  060000     RETURN
