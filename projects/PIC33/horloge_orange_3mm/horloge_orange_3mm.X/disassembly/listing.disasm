001770  EF2106     CLR TMR2
164:                   TMR3 = 0;                       // reset compteur
001772  EF210A     CLR TMR3
165:                   PR2 = (u16)timer;               // Timer period (lsb)
001774  880862     MOV W2, PR2
166:                   PR3 = timer<<16;                // Timer period (msb)
001776  EF210E     CLR PR3
