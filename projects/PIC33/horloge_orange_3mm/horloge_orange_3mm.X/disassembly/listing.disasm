24:                //=============================================================================
25:                #if defined (TMR0IF_bit)
26:                void timer0_init (PRESCALER scaler)
27:                {
28:                    // ========  ToDo  ========
29:                    PIE1  = 0x02;                   // enable interrupt sur timer 2
30:                    INTCON = 0xC0;                  // enable global et periph interrupt
31:                    T0CONbits.T08BIT = 0;           // configure as a 16-bits timer
32:                    T0CONbits.T0PS = scaler;        // set prescaler
33:                    T0CONbits.TMR0ON = 1;           // Enable Timer
34:                    RCONbits.IPEN = 1;              // Interruption prioritaires activées
35:                }
36:                #endif
