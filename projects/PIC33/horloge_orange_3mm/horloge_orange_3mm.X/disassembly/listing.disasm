21:                void pcf8574_write_port (I2C_BUS i2c_bus_id, u8 adr_chip, u8 data)
22:                {
00192E  BE9F88     MOV.D W8, [W15++]
001930  781F8A     MOV W10, [W15++]
001932  780400     MOV W0, W8
