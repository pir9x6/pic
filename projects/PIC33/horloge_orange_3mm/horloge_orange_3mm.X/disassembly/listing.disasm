001708  A96084     BCLR IFS0, #3
62:                    IPC0bits.T1IP = 6;              // priority level
00170A  800520     MOV IPC0, W0
00170C  A1C000     BCLR W0, #12
00170E  A0D000     BSET W0, #13
001710  A0E000     BSET W0, #14
001712  880520     MOV W0, IPC0
63:                    IEC0bits.T1IE = 1;              // Enable Timer 1 interrupt
001714  A86094     BSET IEC0, #3
64:                    TMR1 = 0;                       // reset compteur
001716  EF2100     CLR TMR1
65:                    PR1 = timer;                    // Periode du Timer 1 (64ms)
001718  880811     MOV W1, PR1
66:                    T1CONbits.TON = 1;              // Lancer le Timer 1
00171A  A8E105     BSET 0x105, #7
67:                
68:                    #else
69:                
70:                        #error -- processor ID not specified in generic header file
71:                
72:                    #endif
73:                }
00171C  060000     RETURN
74:                #endif
