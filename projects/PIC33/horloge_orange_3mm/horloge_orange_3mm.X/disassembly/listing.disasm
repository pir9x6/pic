47:                    PIE1bits.TMR1IE = 1;            // enable interrupt sur timer 1
48:                
49:                    INTCONbits.GIE = 1;             // enable global interrupts
50:                    INTCONbits.PEIE = 1;            // enable peripheral interrupts
51:                    
52:                    T0CONbits.T08BIT = 0;           // configure as a 16-bits timer
53:                    T0CONbits.T0PS = scaler;        // set prescaler
54:                    T0CONbits.TMR0ON = 1;           // Enable Timer
55:                    RCONbits.IPEN = 1;              // Interruption prioritaires activées
56:                    
57:                    #elif defined(__PIC24F__) || defined(__dsPIC33F__)
58:                
59:                    // Freq Timer = Fosc / Prescaler / TMR
60:                    T1CONbits.TCKPS = scaler;       // Prescaler (0=1 - 1=8 - 2=64 - 3=256)
0016FA  600063     AND W0, #0x3, W0
0016FC  DD0044     SL W0, #4, W0
0016FE  2FFCF2     MOV #0xFFCF, W2
001700  800823     MOV T1CON, W3
001702  610103     AND W2, W3, W2
001704  700102     IOR W0, W2, W2
001706  880822     MOV W2, T1CON
