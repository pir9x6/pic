235:               //&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
236:               //-------------------------  swaps bits MSB<->LSB   ---------------------------
237:               //&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
238:               u8 swap_bits(u8 i)
239:               {
240:                 return i >> 7
000E16  DE00C7     LSR W0, #7, W1
000E18  714101     IOR.B W2, W1, W2
000E20  714101     IOR.B W2, W1, W2
000E28  714101     IOR.B W2, W1, W2
000E2E  714103     IOR.B W2, W3, W2
000E34  714081     IOR.B W2, W1, W1
000E3A  70C082     IOR.B W1, W2, W1
000E40  70C000     IOR.B W1, W0, W0
241:                      | (i & 0x40) >> 5
000E12  FB8000     ZE W0, W0
000E1A  780080     MOV W0, W1
000E1C  B20401     AND #0x40, W1
000E1E  DE88C5     ASR W1, #5, W1
242:                      | (i & 0x20) >> 3
000E22  780080     MOV W0, W1
000E24  B20201     AND #0x20, W1
000E26  DE88C3     ASR W1, #3, W1
243:                      | (i & 0x10) >> 1
000E2A  6001F0     AND W0, #0x10, W3
000E2C  D18183     ASR W3, W3
244:                      | (i & 0x08) << 1
000E30  6000E8     AND W0, #0x8, W1
000E32  408081     ADD W1, W1, W1
245:                      | (i & 0x04) << 3
000E36  600164     AND W0, #0x4, W2
000E38  DD1143     SL W2, #3, W2
246:                      | (i & 0x02) << 5
000E3C  600062     AND W0, #0x2, W0
000E3E  DD0045     SL W0, #5, W0
247:                      | i << 7;
000E14  DD0147     SL W0, #7, W2
248:               }
000E42  060000     RETURN
---  D:/Electronique/MCU/Libraries/lib_misc/delays.c  ---------------------------------------------------
1:                 //&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
2:                 //&&&               Titre               :   Delays                          &&&
3:                 //&&&               Fichier             :   Delays.h                        &&&
4:                 //&&&               Description         :   Delays in ms and µs             &&&
5:                 //&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
6:                 //&&&               Auteur              :   Pierre BLACHÉ                   &&&
7:                 //&&&               Date                :   Octobre 2013                    &&&
8:                 //&&&               Version             :   3.0                             &&&
9:                 //&&&               MCU                 :   PIC18/PIC24/dsPIC30/dsPIC33/PIC32&&
10:                //&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
11:                //&&&               Fichiers Requis     :    delays.c & delays.h            &&&
12:                //&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
13:                
14:                #include "hardware_profile.h"
15:                #include "delays.h"
16:                
17:                //&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
18:                //------------------------------ Delay in µs ----------------------------------
19:                //&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
20:                #if defined(__PIC32MX__)
21:                void delay_us (unsigned int usec)
22:                {
23:                    unsigned int i;
24:                    for (i=(usec*13); i!=0; i--);        // @ 80 MHz
25:                }
26:                #else
27:                void delay_us (u16 loop)
28:                {
29:                    u16 i, k;
30:                    for (i=loop; i!=0; i--)
0019AA  E00000     CP0 W0
0019AC  320002     BRA Z, 0x19B2
0019AE  E90000     DEC W0, W0
0019B0  3AFFFE     BRA NZ, 0x19AE
31:                        for (k=US_LOOP; k!=0; k--);
32:                }
0019B2  060000     RETURN
33:                #endif
34:                
35:                
36:                //&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
37:                //------------------------------ Delay in ms ----------------------------------
38:                //&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
39:                void delay_ms (u16 loop)
40:                {
0019C6  227102     MOV #0x2710, W2
0019C8  780002     MOV W2, W0
0019CA  37FFF7     BRA 0x19BA
41:                #if defined(__PIC32MX__)
42:                    u16 tWait, tStart;
43:                    tWait=(GetSystemClock()/2000)*loop;
44:                    tStart=ReadCoreTimer();
45:                    while((ReadCoreTimer()-tStart)<tWait);  // wait for the time to pass
46:                #else
47:                    u16 i, k;
48:                    for (i=loop; i!=0; i--)
0019B4  E00000     CP0 W0
0019B6  3A0006     BRA NZ, 0x19C4
0019B8  370009     BRA 0x19CC
0019BA  E90000     DEC W0, W0
0019BE  E90081     DEC W1, W1
0019C0  3A0003     BRA NZ, 0x19C8
0019C2  370004     BRA 0x19CC
0019C4  780080     MOV W0, W1
49:                        for (k=MS_LOOP; k!=0; k--);
0019BC  3AFFFE     BRA NZ, 0x19BA
50:                #endif
51:                }
0019CC  060000     RETURN
52:                
