191:                   T4CONbits.T32 = 1;              // Enable 32-bit Timer mode
192:                   T4CONbits.TCS = 0;              // Select internal instruction cycle clock
193:                   T4CONbits.TGATE = 0;            // Disable Gated Timer mode
194:                   TMR4 = 0;                       // reset compteur
195:                   TMR5 = 0;                       // reset compteur
196:                   PR4 = (u16)timer;               // Timer period (lsb)
197:                   PR5 = timer<<16;                // Timer period (msb)
198:                   T4CONbits.TCKPS = scaler;       // Prescaler (0=1 - 1=8 - 2=64 - 3=256)
199:                   IPC7bits.T5IP = 0x01;           // Set Timer3 Interrupt Priority Level
200:                   IFS1bits.T5IF = 0;              // Clear Timer3 Interrupt Flag
201:                   IEC1bits.T5IE = 1;              // Enable Timer3 interrupt
202:                   T4CONbits.TON = 1;              // Start 32-bit Timer
203:               
204:                   #else
205:               
206:                       #error -- processor ID not specified in generic header file
207:               
208:                   #endif
209:               }
210:               #endif
