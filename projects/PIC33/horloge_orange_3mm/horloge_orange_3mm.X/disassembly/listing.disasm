157:               
158:                   T3CONbits.TON = 0;              // Stop any 16-bit Timer3 operation
001766  A9E113     BCLR 0x113, #7
159:                   T2CONbits.TON = 0;              // Stop any 16/32-bit Timer3 operation
001768  A9E111     BCLR 0x111, #7
160:                   T2CONbits.T32 = 1;              // Enable 32-bit Timer mode
00176A  A86110     BSET T2CON, #3
