62:            void double_2_bcd(f64 flt, u8 bcd_int[], u8 bcd_dec[])
63:            {
64:                bcd_int[0]=0, bcd_int[1]=0, bcd_int[2]=0, bcd_int[3]=0, bcd_int[4]=0;
65:                bcd_int[5]=0, bcd_int[6]=0, bcd_int[7]=0, bcd_int[8]=0, bcd_int[9]=0;
66:                bcd_dec[0]=0, bcd_dec[1]=0, bcd_dec[2]=0, bcd_dec[3]=0, bcd_dec[4]=0;
67:            
68:                while (flt>=1000000000.0) {bcd_int[9]++; flt -= 1000000000.0;}
69:                while (flt>=100000000.0)  {bcd_int[8]++; flt -= 100000000.0;}
70:                while (flt>=10000000.0)   {bcd_int[7]++; flt -= 10000000.0;}
71:                while (flt>=1000000.0)    {bcd_int[6]++; flt -= 1000000.0;}
72:                while (flt>=100000.0)     {bcd_int[5]++; flt -= 100000.0;}
73:                while (flt>=10000.0)      {bcd_int[4]++; flt -= 10000.0;}
74:                while (flt>=1000.0)       {bcd_int[3]++; flt -= 1000.0;}
75:                while (flt>=100.0)        {bcd_int[2]++; flt -= 100.0;}
76:                while (flt>=10.0)         {bcd_int[1]++; flt -= 10.0;}
77:                while (flt>=1.0)          {bcd_int[0]++; flt -= 1.0;}
78:                while (flt>=0.1)          {bcd_dec[0]++; flt -= 0.1;}
79:                while (flt>=0.01)         {bcd_dec[1]++; flt -= 0.01;}
80:                while (flt>=0.001)        {bcd_dec[2]++; flt -= 0.001;}
81:                while (flt>=0.0001)       {bcd_dec[3]++; flt -= 0.0001;}
82:                while (flt>=0.00001)      {bcd_dec[4]++; flt -= 0.00001;}
83:            }
