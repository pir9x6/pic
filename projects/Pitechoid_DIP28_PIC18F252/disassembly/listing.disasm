86:            //&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
87:            //-------------------------- Hexa to BCD Conversion ---------------------------
88:            //&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
89:            void hex_2_bcd(u8 hex, u8 bcd[])
90:            {
91:                bcd[0]=0, bcd[1]=0;
92:                while (hex>=16)  {bcd[1]++; hex -= 16;}
93:                bcd[0] = hex;
94:            }
95:            
96:            void hex16_2_bcd(u16 hex, u8 bcd[])
97:            {
98:                bcd[0]=0, bcd[1]=0, bcd[2]=0, bcd[3]=0;
99:                while (hex>=4096)  {bcd[3]++; hex -= 4096;}
100:               while (hex>=256)   {bcd[2]++; hex -= 256;}
101:               while (hex>=16)    {bcd[1]++; hex -= 16;}
102:               bcd[0] = (u8)hex;
103:           }
104:           
105:           void hex32_2_bcd(u32 hex, u8 bcd[])
106:           {
107:               bcd[0]=0, bcd[1]=0, bcd[2]=0, bcd[3]=0;
108:               bcd[4]=0, bcd[5]=0, bcd[6]=0, bcd[7]=0;
109:               /*while (hex>=16*16*16*16*16*16*16*16)    {bcd[8]++; hex -= 16*16*16*16*16*16*16*16;}
110:               while (hex>=16*16*16*16*16*16*16)       {bcd[7]++; hex -= 16*16*16*16*16*16*16;}
111:               while (hex>=16*16*16*16*16*16)          {bcd[6]++; hex -= 16*16*16*16*16*16;}
112:               while (hex>=16*16*16*16*16)             {bcd[5]++; hex -= 16*16*16*16*16;}
113:               while (hex>=16*16*16*16)                {bcd[4]++; hex -= 16*16*16*16;}*/
114:               while (hex>=16*16*16)                   {bcd[3]++; hex -= 16*16*16;}
115:               while (hex>=16*16)                      {bcd[2]++; hex -= 16*16;}
116:               while (hex>=16)                         {bcd[1]++; hex -= 16;}
117:               bcd[0] = (u8)hex;
118:           }
