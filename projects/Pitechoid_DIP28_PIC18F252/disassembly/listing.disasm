283:           
284:           /*****************************************************************************
285:           * Display an unsigned number with a binary representation
286:           ******************************************************************************/
287:           void lcd_hd44780_write_binary (u8 data)
288:           {
289:               u8 i;
290:           
291:               for (i = 0; i < 8; i++)
292:               {
293:                   _write((data & 0x80) ? '1' : '0', LCD_HD44780_DATA);
294:                   data <<= 1;
295:               }
296:           }
297:           
298:           
299:           /*****************************************************************************
300:           * Display Decimal number
301:           ******************************************************************************/
302:           void lcd_hd44780_write_float (f32 data)
303:           {
304:               u8 bcd_int[10], bcd_dec[5];
305:           
306:               if (data < 0){
307:                   _write ('-', LCD_HD44780_DATA);
308:               }
309:           
310:               float_2_bcd (data, bcd_int, bcd_dec);
311:               _write (bcd_int[9] + 0x30, LCD_HD44780_DATA);
312:               _write (bcd_int[8] + 0x30, LCD_HD44780_DATA);
313:               _write (bcd_int[7] + 0x30, LCD_HD44780_DATA);
314:               _write (bcd_int[6] + 0x30, LCD_HD44780_DATA);
315:               _write (bcd_int[5] + 0x30, LCD_HD44780_DATA);
316:               _write (bcd_int[4] + 0x30, LCD_HD44780_DATA);
317:               _write (bcd_int[3] + 0x30, LCD_HD44780_DATA);
318:               _write (bcd_int[2] + 0x30, LCD_HD44780_DATA);
319:               _write (bcd_int[1] + 0x30, LCD_HD44780_DATA);
320:               _write (bcd_int[0] + 0x30, LCD_HD44780_DATA);
321:               _write (',', LCD_HD44780_DATA);
322:               _write (bcd_dec[0] + 0x30, LCD_HD44780_DATA);
323:               _write (bcd_dec[1] + 0x30, LCD_HD44780_DATA);
324:           }
325:           
326:           
327:           /*****************************************************************************
328:           * Display unsigned numbers
329:           ******************************************************************************/
330:           void lcd_hd44780_write_u8 (u8 data)
331:           {
332:               u8 bcd[5];
333:               dec_2_bcd (data, bcd);
334:               _write (bcd[2] + 0x30, LCD_HD44780_DATA);
335:               _write (bcd[1] + 0x30, LCD_HD44780_DATA);
336:               _write (bcd[0] + 0x30, LCD_HD44780_DATA);
337:           }
338:           
339:           
340:           void lcd_hd44780_write_u16 (u16 data)
341:           {
342:               u8 bcd[5];
343:               dec_2_bcd (data, bcd);
344:               _write (bcd[4] + 0x30, LCD_HD44780_DATA);
345:               _write (bcd[3] + 0x30, LCD_HD44780_DATA);
346:               _write (bcd[2] + 0x30, LCD_HD44780_DATA);
347:               _write (bcd[1] + 0x30, LCD_HD44780_DATA);
348:               _write (bcd[0] + 0x30, LCD_HD44780_DATA);
349:           }
350:           
351:           
352:           void lcd_hd44780_write_u32 (u32 data)
353:           {
354:               u8 bcd[9];
355:               dec_2_bcd32 (data, bcd);
356:               _write (bcd[8] + 0x30, LCD_HD44780_DATA);
357:               _write (bcd[7] + 0x30, LCD_HD44780_DATA);
358:               _write (bcd[6] + 0x30, LCD_HD44780_DATA);
359:               _write (bcd[5] + 0x30, LCD_HD44780_DATA);
360:               _write (bcd[4] + 0x30, LCD_HD44780_DATA);
361:               _write (bcd[3] + 0x30, LCD_HD44780_DATA);
362:               _write (bcd[2] + 0x30, LCD_HD44780_DATA);
363:               _write (bcd[1] + 0x30, LCD_HD44780_DATA);
364:               _write (bcd[0] + 0x30, LCD_HD44780_DATA);
365:           }
