476:           static _INLINE _COUNT_TYPE ctoa(FILE *fp, char c)
477:           {
478:               int l,w;
479:           
480:               /* Get width */
481:               w = width ? width - 1 : width;
482:           
483:           #if defined(_VFPF_LEFT) || defined(_VFPF_WIDTH)
484:               /* Left justify ? Put out character */
485:               if (flags & MINUS_FLAG) {
486:                   fputc(c, fp);
487:               }
488:           #endif
489:           
490:               /* Put out padding */
491:               w = (w < 0) ? 0 : w;
492:               l = 0;
493:               while (l < w) {
494:                   fputc(' ', fp);
495:                   ++l;
496:               }
497:               /* Right justify ? Put out string */
498:           #if defined(_VFPF_LEFT) || defined(_VFPF_WIDTH)
499:               if (!(flags & MINUS_FLAG)) {
500:           #endif
501:                   fputc(c, fp);
502:           #if defined(_VFPF_LEFT) || defined(_VFPF_WIDTH)
503:               }
504:           #endif
505:           
506:           #ifdef _VFPF_COUNT_CHARS
507:               return l+1;
508:           #endif
509:           }
510:           #endif
