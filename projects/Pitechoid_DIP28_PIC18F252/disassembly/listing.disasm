116:                   PIN_LED_SEC = !PIN_LED_SEC;
117:               }
118:               else if (CntTmrIncSec == 999)
119:               {
120:                   time_has_changed_timer = TRUE;
121:                   PIN_LED_SEC = !PIN_LED_SEC;
122:                   CntTmrIncSec = 0;
123:               }
124:           }
