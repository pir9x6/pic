216:           /*****************************************************************************
217:           * Scroll line
218:           * works partially, not finished
219:           ******************************************************************************/
220:           void lcd_hd44780_scroll_line(u8 row, const char *text, u8 offset)
221:           {
222:               u8 i;
223:           
224:               lcd_hd44780_set_position(row, 0);
225:           
226:               for(i = 0; i < 20 /*LCD_HD44780_WIDTH*/; i++)
227:               {
228:                   char c = text[offset + i];
229:           
230:                   if(c == '\0')
231:                       c = ' ';
232:           
233:                   _write(c, LCD_HD44780_DATA);
234:               }
235:           }
236:           
237:           
238:           /*****************************************************************************
239:           * Display a hex digit
240:           ******************************************************************************/
241:           static void _write_hex_digit (u8 data)
242:           {
243:               data &= 0x0F;
244:           
245:               if (data < 10)
246:                   _write(data + '0', LCD_HD44780_DATA);
247:               else
248:                   _write(data + 'A' - 10, LCD_HD44780_DATA);
249:           }
250:           
251:           void lcd_hd44780_write_hex8 (u8 data)
252:           {
253:               _write_hex_digit(data >> 4);
254:               _write_hex_digit(data);
255:           }
256:           
257:           void lcd_hd44780_write_hex16 (u16 data)
258:           {
259:               _write_hex_digit((u8)data >> 12);
260:               _write_hex_digit((u8)data >> 8);
261:               _write_hex_digit((u8)data >> 4);
262:               _write_hex_digit((u8)data);
263:           }
264:           
265:           
266:           /*****************************************************************************
267:           * Display an unsigned number with a binary representation
268:           ******************************************************************************/
269:           void lcd_hd44780_write_1digit(u8 data)
270:           {
271:               u8 bcd[5];
272:               dec_2_bcd (data, bcd);
273:               _write (bcd[0] + 0x30, LCD_HD44780_DATA);
274:           }
275:           
