38:            void float_2_bcd(f32 flt, u8 bcd_int[], u8 bcd_dec[])
39:            {
40:                bcd_int[0]=0, bcd_int[1]=0, bcd_int[2]=0, bcd_int[3]=0, bcd_int[4]=0;
41:                bcd_int[5]=0, bcd_int[6]=0, bcd_int[7]=0, bcd_int[8]=0, bcd_int[9]=0;
42:                bcd_dec[0]=0, bcd_dec[1]=0, bcd_dec[2]=0, bcd_dec[3]=0, bcd_dec[4]=0;
43:            
44:                while (flt>=1000000000.0) {bcd_int[9]++; flt -= 1000000000.0;}
45:                while (flt>=100000000.0)  {bcd_int[8]++; flt -= 100000000.0;}
46:                while (flt>=10000000.0)   {bcd_int[7]++; flt -= 10000000.0;}
47:                while (flt>=1000000.0)    {bcd_int[6]++; flt -= 1000000.0;}
48:                while (flt>=100000.0)     {bcd_int[5]++; flt -= 100000.0;}
49:                while (flt>=10000.0)      {bcd_int[4]++; flt -= 10000.0;}
50:                while (flt>=1000.0)       {bcd_int[3]++; flt -= 1000.0;}
51:                while (flt>=100.0)        {bcd_int[2]++; flt -= 100.0;}
52:                while (flt>=10.0)         {bcd_int[1]++; flt -= 10.0;}
53:                while (flt>=1.0)          {bcd_int[0]++; flt -= 1.0;}
54:                while (flt>=0.1)          {bcd_dec[0]++; flt -= 0.1;}
55:                while (flt>=0.01)         {bcd_dec[1]++; flt -= 0.01;}
56:                while (flt>=0.001)        {bcd_dec[2]++; flt -= 0.001;}
57:                while (flt>=0.0001)       {bcd_dec[3]++; flt -= 0.0001;}
58:                while (flt>=0.00001)      {bcd_dec[4]++; flt -= 0.00001;}
59:            }
