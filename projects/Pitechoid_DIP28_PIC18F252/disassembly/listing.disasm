20:            void dec_2_bcd32(u32 dec, u8 bcd[])
21:            {
22:                bcd[0]=0, bcd[1]=0, bcd[2]=0, bcd[3]=0, bcd[4]=0;
23:                bcd[5]=0, bcd[6]=0, bcd[7]=0, bcd[8]=0, bcd[9]=0;
24:            
25:                while (dec>=1000000000) {bcd[9]++; dec -= 1000000000;}
26:                while (dec>=100000000)  {bcd[8]++; dec -= 100000000;}
27:                while (dec>=10000000)   {bcd[7]++; dec -= 10000000;}
28:                while (dec>=1000000)    {bcd[6]++; dec -= 1000000;}
29:                while (dec>=100000)     {bcd[5]++; dec -= 100000;}
30:                while (dec>=10000)      {bcd[4]++; dec -= 10000;}
31:                while (dec>=1000)       {bcd[3]++; dec -= 1000;}
32:                while (dec>=100)        {bcd[2]++; dec -= 100;}
33:                while (dec>=10)         {bcd[1]++; dec -= 10;}
34:                bcd[0] = (u8)dec;
35:            }
36:            
