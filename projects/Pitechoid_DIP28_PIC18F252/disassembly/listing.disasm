73:            /*****************************************************************************
74:            * Dump I2C Device
75:            ******************************************************************************/
76:            result_t i2c_dump (I2C_BUS i2c_id, u8 dev_addr, u16 start, u16 length)
77:            {
78:                u8 i, row, col;
79:                u8 read_data = 0;
80:                u16 end = start + length;
81:            
82:                printf("\r\n-------------- Dump of I2C Chip --------------\r\n");
83:                printf("Bus    : %u\r\n", i2c_id);
84:                printf("Address: 0x%02X\r\n", dev_addr);
85:                printf("Range  : 0x%04X - 0x%04X\r\n\r\n", start, end - 1);
86:            
87:                printf("\r\n    ");
88:            
89:                /* print '0' to 'F' */
90:                for (i = 0; i < 16; i++)
91:                {
92:                    printf(" %X", i);
93:                    printf(" ");
94:                }
95:            
96:                for (row = 0; row < 16; row++)
97:                {
98:                    printf("%02X: ", row);
99:                    for (col = 0; col < 16; col++)
100:                   {
101:                       i2c_read_reg(i2c_id, dev_addr, (u8)((row << 4) | col), &read_data);
102:                       printf("%02X ", read_data);
103:                   }
104:                   printf("\r\n");
105:               }
106:           
107:               return SUCCESS;
108:           }
