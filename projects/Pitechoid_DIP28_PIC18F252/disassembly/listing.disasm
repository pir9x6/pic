90:            /*****************************************************************************
91:            * Check if conversion is done
92:            * Used only when the DS1631 is configured in one-shot mode
93:            ******************************************************************************/
94:            result_t ds1631_is_conv_done (I2C_BUS i2c_bus_id, u8 dev_addr, bool_t *done)
95:            {
96:                u8 config;
97:            
98:                if (i2c_read_reg(i2c_bus_id, dev_addr, DS1631_REG_ACCESS_CONFIG, &config) != SUCCESS)
99:                {
100:                   i2c_stop(i2c_bus_id);
101:                   return ERROR;
102:               }
103:           
104:               if (config & 0x80){
105:                   *done = TRUE;
106:               }
107:               else{
108:                   *done = FALSE;
109:               }
110:           
111:               return SUCCESS;
112:           }
113:           
114:           
115:           /*****************************************************************************
116:           * Stop conversion
117:           ******************************************************************************/
118:           result_t ds1631_stop_conv (I2C_BUS i2c_bus_id, u8 dev_addr)
119:           {
120:               /* stop temperature acquisition */
121:               if (i2c_start (i2c_bus_id) != SUCCESS)
122:                 {
123:                   i2c_stop(i2c_bus_id);
124:                   return ERROR;
125:               }
126:           
127:               if (i2c_write (i2c_bus_id, I2C_ADDR_WR(dev_addr)) != SUCCESS)
128:               {
129:                   i2c_stop(i2c_bus_id);
130:                   return ERROR;
131:               }
132:           
133:               if (i2c_write (i2c_bus_id, DS1631_REG_STOP_CONVERT) != SUCCESS)
134:               {
135:                   i2c_stop(i2c_bus_id);
136:                   return ERROR;
137:               }
138:           
139:               if (i2c_stop  (i2c_bus_id) != SUCCESS)
140:                   return ERROR;
141:           
142:               return SUCCESS;
143:           }
144:           
