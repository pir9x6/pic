38:            /*****************************************************************************
39:            * Read from the port of PCF8574
40:            ******************************************************************************/
41:            result_t pcf8574_read_port (I2C_BUS i2c_bus_id, u8 dev_addr, u8 *data)
42:            {
43:                if (i2c_start(i2c_bus_id) != SUCCESS)
44:                    return ERROR;
45:            
46:                if (i2c_write(i2c_bus_id, I2C_ADDR_RD(dev_addr)) != SUCCESS)
47:                {
48:                    i2c_stop(i2c_bus_id);
49:                    return ERROR;
50:                }
51:            
52:                if (i2c_read(i2c_bus_id, I2C_NACK, data) != SUCCESS)
53:                {
54:                    i2c_stop(i2c_bus_id);
55:                    return ERROR;
56:                }
57:            
58:                if (i2c_stop(i2c_bus_id) != SUCCESS)
59:                    return ERROR;
60:            
61:                return SUCCESS;
62:            }
63:            
