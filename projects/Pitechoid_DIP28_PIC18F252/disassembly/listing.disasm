69:            /*****************************************************************************
70:            * Get X, Y, Z acceleration values from sensor
71:            ******************************************************************************/
72:            static result_t _read_raw (I2C_BUS i2c_bus_id, u8 dev_addr, s8 *x, s8 *y, s8 *z)
73:            {
74:                u8 raw_x;
75:                u8 raw_y;
76:                u8 raw_z;
77:            
78:                if (i2c_read_reg(i2c_bus_id, dev_addr, MMA7660_REG_X, &raw_x) != SUCCESS)
79:                    return ERROR;
80:            
81:                if (i2c_read_reg(i2c_bus_id, dev_addr, MMA7660_REG_Y, &raw_y) != SUCCESS)
82:                    return ERROR;
83:            
84:                if (i2c_read_reg(i2c_bus_id, dev_addr, MMA7660_REG_Z, &raw_z) != SUCCESS)
85:                    return ERROR;
86:            
87:                /* Sign extension from 6 bits to 8 bits */
88:                if (raw_x & 0x20)
89:                    raw_x |= 0xC0;
90:                else
91:                    raw_x &= 0x3F;
92:            
93:                if (raw_y & 0x20)
94:                    raw_y |= 0xC0;
95:                else
96:                    raw_y &= 0x3F;
97:            
98:                if (raw_z & 0x20)
99:                    raw_z |= 0xC0;
100:               else
101:                   raw_z &= 0x3F;
102:           
103:               *x = (s8)raw_x;
104:               *y = (s8)raw_y;
105:               *z = (s8)raw_z;
106:           
107:               return SUCCESS;
108:           }
109:           
110:           result_t mma7660_read_accel(I2C_BUS i2c_bus_id, u8 dev_addr, float *x, float *y, float *z)
111:           {
112:               s8 raw_x;
113:               s8 raw_y;
114:               s8 raw_z;
115:           
116:               if (_read_raw(i2c_bus_id, dev_addr, &raw_x, &raw_y, &raw_z) != SUCCESS)
117:               {
118:                   return ERROR;
119:               }
120:           
121:               *x = (float)raw_x * MMA7660_SENSITIVITY;
122:               *y = (float)raw_y * MMA7660_SENSITIVITY;
123:               *z = (float)raw_z * MMA7660_SENSITIVITY;
124:           
125:               return SUCCESS;
126:           }
